# outbox - the transactional outbox pattern over std.sql.
#
# Write a business row and the message you owe the outside world (send a
# webhook, publish an event) in one database transaction, so both commit or
# neither does. A separate `relay` call then delivers queued messages,
# retrying with backoff on failure and dead-lettering a message once it has
# failed too many times. One bad message never blocks the rest.
#
#   import std.sql
#   import outbox
#
#   db = sql.open("app.db")
#   outbox.init(db)
#
#   sql.transaction(db, fn(tx) {
#       sql.exec(tx, "insert into orders (id) values (?)", [order_id])
#       outbox.add(tx, "order.created", { order_id: order_id })
#   })
#
#   summary = outbox.relay(db, fn(msg) http.post(webhook_url, msg.payload))
#   # { delivered: 1, failed: 0, dead: 0 }
#
# Delivery is at-least-once, never exactly-once: a crash between a successful
# delivery and marking the row delivered means `relay` retries the same
# message. Every message carries a stable `id` - dedupe on it in `deliver_fn`.
#
# The caller owns the connection: every function here takes an already-open
# `db` (or `tx`) handle. This package never opens, closes or configures one,
# so it needs no capabilities of its own.

import std.sql
import std.json
import std.uuid
import std.time
import std.fmt

fn bad_arg(message) = error({ kind: "bug", reason: "bad_argument", message: message })

# An options map passed where named arguments now go: say how to write it.
fn no_opts_map(func, v, example) {
    if is_map(v) {
        bad_arg(
            "outbox.{func}: options are named arguments now: write {example}, not an options map",
        )
    }
    null
}

fn check_int(func, name, v, least) {
    unless type_of(v) == "int" and v >= least {
        what = if least > 0 { "a positive Int" } else { "a non-negative Int" }
        bad_arg("outbox.{func}: {name} must be {what}, got {fmt.inspect(v)}")
    }
    null
}

fn check_now(func, now) {
    unless now == null or type_of(now) == "int" {
        bad_arg("outbox.{func}: now must be an Int of Unix milliseconds, got {fmt.inspect(now)}")
    }
    if now == null { time.now() } else { now }
}

# Describes the first part of `v` that a JSON round trip would not give back
# unchanged ("a decimal at `.amount`"), or returns null when all of it would.
# Decimals, records, secrets, bytes and functions all encode to something that
# decodes as a different value; refusing them is better than handing back a
# silently different one later.
fn unstorable(v, path = "") {
    t = type_of(v)
    here = if path == "" { "" } else { " at `{path}`" }
    if t == "null" or t == "bool" or t == "string" or t == "int" { null } else if t == "float" {
        back = try { json.decode(json.encode(v)) } catch (e) { null }
        if type_of(back) == "float" and back == v { null } else { "the float {v}{here}" }
    } else if t == "list" {
        mut found = null
        for (i, x) in enumerate(v) {
            found = unstorable(x, "{path}[{i}]")
            if found != null { break }
        }
        found
    } else if t == "map" {
        mut found = null
        for (k, x) in v {
            found = unstorable(x, "{path}.{k}")
            if found != null { break }
        }
        found
    } else { "a {t}{here}" }
}

fn row_to_msg(row) = {
    id: row.id,
    topic: row.topic,
    payload: json.decode(row.payload),
    status: row.status,
    attempts: row.attempts,
    max_attempts: row.max_attempts,
    created_at: row.created_at,
    next_attempt_at: row.next_attempt_at,
    delivered_at: row.delivered_at,
    last_error: if row.last_error == null { null } else { json.decode(row.last_error) },
}

# Normalize a caught value into the package's own `{ kind, message }` shape.
# `deliver_fn` may throw an operational map (via `error({kind, message})`) or
# a plain prose string (a programmer mistake) - both are recorded the same way.
fn error_shape(e) {
    if is_map(e) {
        { kind: get(e, "kind"), message: get(e, "message") }
    } else {
        { kind: null, message: string(e) }
    }
}

# base * 2^(attempts - 1), capped at `cap`, computed by repeated doubling so it
# stays exact integer arithmetic (no float rounding in a millisecond delay).
fn backoff_delay(base, attempts, cap) {
    mut delay = base
    mut n = 1
    while n < attempts and delay < cap {
        delay = delay * 2
        n = n + 1
    }
    if delay > cap { cap } else { delay }
}

## Creates the outbox table and its relay index if they do not already exist,
## and returns null. Safe to call every time your program starts.
##
## errors: `sql` when the table cannot be created.
##
## example:
##   outbox.init(db)
export fn init(db) {
    sql.exec(
        db,
        "create table if not exists outbox_messages (id text primary key, topic text not null, payload text not null, status text not null, attempts integer not null default 0, max_attempts integer not null, created_at integer not null, next_attempt_at integer not null, delivered_at integer, updated_at integer not null, last_error text)",
    )
    sql.exec(
        db,
        "create index if not exists outbox_messages_relay_idx on outbox_messages (status, next_attempt_at, created_at, id)",
    )
    null
}

## Queues a message and returns its id.
##
## Call this inside the same `sql.transaction` as your business write - the
## row you are recording and the message you owe both commit together, or
## neither does. `payload` must be plain data that JSON gives back unchanged
## (null, bools, ints, floats, strings, and lists and maps of those), so
## `deliver_fn` receives exactly what was added.
##
## `id` is your own id (default a fresh `uuid.v7()`); `max_attempts` is how
## many delivery attempts `relay` makes before dead-lettering this message;
## `now` is the Unix ms to stamp it with (default `time.now()` - inject a fixed
## value in tests).
##
## errors: `outbox`/`not_storable` when `payload` holds a decimal, record,
## secret, bytes or function; `outbox`/`duplicate_id` when a message with `id`
## already exists; `bug`/`bad_argument` for an empty topic, a non-string `id`,
## a `max_attempts` that is not a positive Int or a non-Int `now`; `sql` when
## the write fails.
##
## example:
##   outbox.add(tx, "order.created", { order_id: "o-1" }, max_attempts: 10)
export fn add(db, topic, payload, id = null, max_attempts = 5, now = null) {
    no_opts_map("add", id, "outbox.add(db, topic, payload, id: \"m-1\", now: 0)")
    unless type_of(topic) == "string" and topic != "" {
        bad_arg("outbox.add: topic must be a non-empty string, got {fmt.inspect(topic)}")
    }
    unless id == null or type_of(id) == "string" and id != "" {
        bad_arg("outbox.add: id must be a non-empty string, got {fmt.inspect(id)}")
    }
    check_int("add", "max_attempts", max_attempts, 1)
    at = check_now("add", now)
    why = unstorable(payload)
    if why != null {
        error(
            {
                kind: "outbox",
                reason: "not_storable",
                message: "outbox.add: the payload holds {why}, which JSON would not give back unchanged; send plain data (convert decimals to strings, records to maps, and never put a secret in a message)",
            },
        )
    }
    mid = if id == null { uuid.v7() } else { id }
    if id != null {
        taken = sql.query_one(db, "select id from outbox_messages where id = ?", [mid])
        if taken != null {
            error(
                {
                    kind: "outbox",
                    reason: "duplicate_id",
                    id: mid,
                    message: "outbox.add: a message with id {mid} is already queued",
                },
            )
        }
    }
    sql.exec(
        db,
        "insert into outbox_messages (id, topic, payload, status, attempts, max_attempts, created_at, next_attempt_at, delivered_at, updated_at, last_error) values (?, ?, ?, 'pending', 0, ?, ?, ?, null, ?, null)",
        [mid, topic, json.encode(payload), max_attempts, at, at, at],
    )
    mid
}

## Delivers the pending messages that are due, oldest first, and returns
## `{ delivered, failed, dead }` counts.
##
## Calls `deliver_fn(msg)` for each - `msg` has `id`, `topic`, `payload`,
## `status`, `attempts`, `max_attempts`, `created_at`, `next_attempt_at`,
## `delivered_at` and `last_error`. `deliver_fn`'s return value is ignored; it
## signals failure by throwing.
##
## A message that returns normally is marked delivered. A message that throws
## has its attempt recorded and is rescheduled with exponential backoff
## (`base_backoff_ms * 2^(attempts - 1)`, capped at `max_backoff_ms`) until it
## reaches its `max_attempts`, when it is marked dead instead. Each
## `deliver_fn` call is caught on its own, so one bad message is recorded and
## skipped rather than blocking the batch. At most `batch_size` messages are
## read per call; `now` (Unix ms, default `time.now()`) picks which are due.
##
## Delivery is at-least-once: a crash between a successful `deliver_fn` call
## and the update that marks it delivered means the message is retried on the
## next `relay`, so dedupe on `msg.id`. Run one relay at a time per table: two
## concurrent relays read the same pending rows and both deliver them.
##
## errors: `bug`/`bad_argument` when `deliver_fn` is not a function, a count or
## delay is not a positive (or, for `base_backoff_ms`, non-negative) Int, or
## `now` is not an Int; `sql` when the table cannot be read or updated.
## `deliver_fn`'s own errors are never re-thrown.
##
## example:
##   outbox.relay(db, fn(msg) publish(msg), batch_size: 50)   # {delivered: 3, failed: 0, dead: 0}
export fn relay(db, deliver_fn, batch_size = 100, base_backoff_ms = 1000, max_backoff_ms = 60000, now = null) {
    no_opts_map("relay", batch_size, "outbox.relay(db, deliver_fn, batch_size: 50, now: 0)")
    unless type_of(deliver_fn) == "function" {
        bad_arg("outbox.relay: deliver_fn must be a function, got {type_of(deliver_fn)}")
    }
    check_int("relay", "batch_size", batch_size, 1)
    check_int("relay", "base_backoff_ms", base_backoff_ms, 0)
    check_int("relay", "max_backoff_ms", max_backoff_ms, 1)
    at = check_now("relay", now)
    base_backoff = base_backoff_ms
    max_backoff = max_backoff_ms

    rows = sql.query(
        db,
        "select * from outbox_messages where status = 'pending' and next_attempt_at <= ? order by created_at asc, id asc limit ?",
        [at, batch_size],
    )

    mut delivered = 0
    mut failed = 0
    mut dead = 0

    for row in rows {
        msg = row_to_msg(row)
        try {
            deliver_fn(msg)
            sql.exec(
                db,
                "update outbox_messages set status = 'delivered', delivered_at = ?, updated_at = ? where id = ?",
                [at, at, msg.id],
            )
            delivered = delivered + 1
        } catch (e) {
            attempts = msg.attempts + 1
            err = error_shape(e)
            if attempts >= msg.max_attempts {
                sql.exec(
                    db,
                    "update outbox_messages set status = 'dead', attempts = ?, updated_at = ?, last_error = ? where id = ?",
                    [attempts, at, json.encode(err), msg.id],
                )
                dead = dead + 1
            } else {
                delay = backoff_delay(base_backoff, attempts, max_backoff)
                sql.exec(
                    db,
                    "update outbox_messages set attempts = ?, next_attempt_at = ?, updated_at = ?, last_error = ? where id = ?",
                    [attempts, at + delay, at, json.encode(err), msg.id],
                )
                failed = failed + 1
            }
        }
    }

    { delivered: delivered, failed: failed, dead: dead }
}

## The messages awaiting delivery, oldest first.
##
## Includes messages that already failed once and are backing off, not only
## ones never attempted - compare `next_attempt_at` if you need to tell them
## apart.
##
## errors: `sql` when the table cannot be read.
##
## example:
##   len(outbox.pending(db))   # 3
export fn pending(db) {
    rows = sql.query(
        db,
        "select * from outbox_messages where status = 'pending' order by created_at asc, id asc",
    )
    map(rows, row_to_msg)
}

## The messages that reached `max_attempts` and will not be retried
## automatically, oldest first. Use `retry_dead` to give one another chance.
##
## errors: `sql` when the table cannot be read.
##
## example:
##   map(outbox.dead(db), fn(m) m.id)   # ["msg-2"]
export fn dead(db) {
    rows = sql.query(
        db,
        "select * from outbox_messages where status = 'dead' order by created_at asc, id asc",
    )
    map(rows, row_to_msg)
}

## Moves a dead message back to pending with its attempt count reset, so the
## next `relay` picks it up at `now` (Unix ms, default `time.now()`). Returns
## null.
##
## errors: `outbox`/`not_found` (with `id`) when `id` names no dead message;
## `bug`/`bad_argument` when `now` is not an Int.
##
## example:
##   outbox.retry_dead(db, "msg-2")
export fn retry_dead(db, id, now = null) {
    no_opts_map("retry_dead", now, "outbox.retry_dead(db, id, now: 0)")
    at = check_now("retry_dead", now)
    affected = sql.exec(
        db,
        "update outbox_messages set status = 'pending', attempts = 0, next_attempt_at = ?, updated_at = ?, last_error = null where id = ? and status = 'dead'",
        [at, at, id],
    )
    if affected == 0 {
        error(
            {
                kind: "outbox",
                reason: "not_found",
                id: id,
                message: "outbox.retry_dead: no dead message with id {id}",
            },
        )
    }
    null
}

## Deletes delivered and dead messages last touched before `older_than` (Unix
## ms) and returns how many rows it removed. Pending messages are never
## pruned, however old - they are still waiting on a real outcome.
##
## errors: `bug`/`bad_argument` when `older_than` is not an Int; `sql` when the
## delete fails.
##
## example:
##   outbox.prune(db, time.now() - 7 * 86400000)   # 120
export fn prune(db, older_than) {
    unless type_of(older_than) == "int" {
        bad_arg(
            "outbox.prune: older_than must be an Int of Unix milliseconds, got {fmt.inspect(older_than)}",
        )
    }
    sql.exec(
        db,
        "delete from outbox_messages where status in ('delivered', 'dead') and updated_at < ?",
        [older_than],
    )
}
